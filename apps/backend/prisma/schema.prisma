datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR
  EMPLOYEE
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

model User {
  id        String   @id @default(uuid())
  dni       String   @unique
  email     String?  @unique
  password  String?
  firstName String
  lastName  String
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  attendances       Attendance[]
  attendanceRecords AttendanceRecord[]

  @@index([dni])
}

model Schedule {
  id               String   @id @default(uuid())
  name             String
  checkInTime      String   // e.g. '08:00'
  checkOutTime     String   // e.g. '17:00'
  toleranceMinutes Int      @default(0)
  createdAt        DateTime @default(now())
  users            User[]
}

model AttendanceRecord {
  id                  String    @id @default(uuid())
  userId              String
  date                String    // e.g. '2023-10-25'
  checkIn             DateTime
  checkOut            DateTime?
  isLate              Boolean   @default(false)
  minutesLate         Int       @default(0)
  workedHours         Float?
  justifiedAbsence    Boolean   @default(false)
  justificationReason String?
  correctedBy         String?
  correctionReason    String?
  createdAt           DateTime  @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Attendance {
  id        String         @id @default(uuid())
  userId    String
  type      AttendanceType
  timestamp DateTime       @default(now())
  device    String?
  ipAddress String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}
